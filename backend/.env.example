# Backend-only local configuration. Copy this file to .env.
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# Paste the connection string from MongoDB Atlas > Connect > Drivers.
# The Atlas project ID is not part of the MongoDB driver URL.
